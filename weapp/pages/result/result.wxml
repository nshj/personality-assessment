<view class="page">
  <view class="head">
    <view class="h2">结果卡</view>
    <view class="lead">{{loading ? '正在生成…' : '一张 750×1334 的图，适合发朋友圈或存着。'}}</view>
  </view>

  <view wx:if="{{err}}" class="err">{{err}}</view>

  <image
    wx:if="{{src}}"
    class="preview"
    src="{{src}}"
    mode="widthFix"
    show-menu-by-longpress="{{true}}"
  />

  <canvas type="2d" id="card" class="scard {{src ? 'hide' : ''}}"></canvas>

  <view wx:if="{{src}}" class="acts">
    <button class="btn" bindtap="onSave">保存到相册</button>
    <view class="tipx">长按图片也可以直接保存或发给朋友。</view>
  </view>
</view>
