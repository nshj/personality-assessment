.hint {
  font-size: 23rpx;
  color: var(--muted);
  margin-bottom: 24rpx;
}

.item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 30rpx;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 22rpx;
  margin-bottom: 18rpx;
}

.il { display: flex; flex-direction: column; }

.icode {
  font-family: Georgia, serif;
  font-size: 40rpx;
  letter-spacing: 2rpx;
  color: var(--a1);
  line-height: 1.2;
}

.iname {
  font-size: 24rpx;
  color: var(--ink2);
  margin-top: 8rpx;
}

.ir {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.idate {
  font-size: 22rpx;
  color: var(--muted);
}

.iconf {
  font-size: 22rpx;
  margin-top: 8rpx;
}

.g-ok { color: var(--ok); }
.g-mid { color: var(--warn); }
.g-low { color: var(--bad); }

.clear {
  text-align: center;
  font-size: 24rpx;
  color: var(--muted);
  padding: 36rpx 0;
}

.empty {
  padding: 120rpx 20rpx;
  text-align: center;
}

.empty .lead { margin: 20rpx 0 44rpx; }
